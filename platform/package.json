{
  "name": "alesya-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "prebuild": "node scripts/prepare-demo-db.mjs",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/start-standalone.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-db.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "inventory:import": "node --env-file-if-exists=.env.local scripts/import-inventory.mjs",
    "admin:setup": "node scripts/setup-admin.mjs",
    "admin:totp": "node scripts/setup-admin-totp.mjs",
    "test": "node --test --experimental-strip-types",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "package:cpanel": "node scripts/package-cpanel.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
