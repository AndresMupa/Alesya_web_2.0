    "drizzle-orm": "0.45.4",
    "embla-carousel-react": "^8.6.0",
    "imapflow": "2.9.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.2.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.15.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
